# Ghost in the Audit — copy to .env and fill in only what you actually need.
# A local audit run needs no secrets at all; everything below is optional.

# Optional: where the citation-gate hook appends its verdict log
# (defaults to ./logs/citation-gate.log, which is gitignored).
# CITATION_GATE_LOG=./logs/citation-gate.log

# Optional: GitHub token, ONLY if you publish demo reports from CI.
# Never commit a real token — this file must contain placeholders only.
# GITHUB_TOKEN=ghp_placeholder_not_a_real_token
